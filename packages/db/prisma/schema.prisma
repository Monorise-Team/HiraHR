// Baza hira_hr (ADR-0096, ADR-0104): sesje przeglądarki i kanał zdarzeń Core (etap 0).
// Osoba, pracownik i firma pochodzą z MonoriseCore (sub, employee_id i org_id z tokenu), więc HiraHR nie ma własnych kont.
// Schemat "auth": sesje przeglądarki (BFF, @monorise-team/auth). Szukamy ich po skrócie identyfikatora z ciasteczka,
// zanim wiadomo, czyja to sesja, więc są bez RLS; tokeny w środku są zaszyfrowane.
// Schemat "public": funkcje pomocnicze RLS (migracje) oraz tabele techniczne kanału zdarzeń Core bez danych firmowych.
// Aplikacja łączy się rolą hira_hr_app bez uprawnień właściciela tabel (ADR-0037); każda tabela domenowa
// z danymi osób albo firm od etapu 1 dostaje RLS (ENABLE + FORCE) z użyciem funkcji pomocniczych.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

/// Sesja przeglądarki: tokeny z Core zaszyfrowane po stronie serwera (ADR-0050).
model Session {
  /// SHA-256 identyfikatora z ciasteczka; samego identyfikatora baza nie zna.
  id             String   @id
  /// Konto Monorise (sub z tokenu Core).
  accountId      String   @map("account_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  /// Zaszyfrowane tokeny, kontekst firmy i dane osoby.
  data           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("auth")
}

/// Kursor ostatnio przetworzonego zdarzenia z kanału HTTP produktu (bez danych firmowych, bez RLS).
model EventFeedCursor {
  /// Nazwa kanału zdarzeń, np. "core".
  id        String   @id
  /// Numer ostatnio przetworzonego zdarzenia (liczba dziesiętna jako napis).
  sequence  String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_feed_cursors")
  @@schema("public")
}

/// Zapis przetworzonych zdarzeń do deduplikacji po stronie odbiorcy (bez danych firmowych, bez RLS).
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
  @@schema("public")
}

// ── Etap 1: kartoteka (ADR-0104) ─────────────────────────────────────────────────────────────────
// Wszystkie tabele mają wymuszone RLS po organization_id. Pola *_encrypted zawierają wyłącznie szyfrogram
// AES-256-GCM (format v1.<klucz>.<iv>.<szyfrogram>.<znacznik>), nigdy jawne wartości.

enum ContractType {
  PROBATION
  FIXED_TERM
  INDEFINITE
  MANDATE
  SPECIFIC_TASK
  B2B

  @@schema("public")
}

enum SensitiveAccessAction {
  READ
  UPDATE

  @@schema("public")
}

/// Stanowisko z katalogu firmy (np. „Magazynierka”). Archiwizowane, nie usuwane, bo wskazują je umowy.
model Position {
  id             String               @id @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String
  description    String?
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  contracts      EmploymentContract[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("positions")
  @@schema("public")
}

/// Kartoteka pracownika Core (`employeeId`): dane kadrowe spoza Core i zaszyfrowane dane wrażliwe.
model EmployeeProfile {
  organizationId       String    @map("organization_id") @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  personalEmail        String?   @map("personal_email")
  personalPhone        String?   @map("personal_phone")
  homeAddress          Json?     @map("home_address") @db.JsonB
  mailingAddress       Json?     @map("mailing_address") @db.JsonB
  emergencyContact     Json?     @map("emergency_contact") @db.JsonB
  peselEncrypted       String?   @map("pesel_encrypted")
  bankAccountEncrypted String?   @map("bank_account_encrypted")
  idDocumentEncrypted  String?   @map("id_document_encrypted")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByAccountId   String?   @map("updated_by_account_id") @db.Uuid

  @@id([organizationId, employeeId])
  @@map("employee_profiles")
  @@schema("public")
}

/// Umowa pracownika z historią (kolejne wiersze). Wynagrodzenie jest daną wrażliwą (szyfrogram).
model EmploymentContract {
  id                 String       @id @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  employeeId         String       @map("employee_id") @db.Uuid
  type               ContractType
  startDate          DateTime     @map("start_date") @db.Date
  endDate            DateTime?    @map("end_date") @db.Date
  fteNumerator       Int?         @map("fte_numerator")
  fteDenominator     Int?         @map("fte_denominator")
  positionId         String?      @map("position_id") @db.Uuid
  salaryEncrypted    String?      @map("salary_encrypted")
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdByAccountId String       @map("created_by_account_id") @db.Uuid
  position           Position?    @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, employeeId, startDate])
  @@map("employment_contracts")
  @@schema("public")
}

/// Dziennik dostępu do danych wrażliwych: tylko dopisywanie (rola aplikacji ma SELECT i INSERT).
model SensitiveAccessLog {
  id             String                @id @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  actorAccountId String                @map("actor_account_id") @db.Uuid
  employeeId     String                @map("employee_id") @db.Uuid
  action         SensitiveAccessAction
  fields         String[]
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, employeeId, createdAt, id], map: "sensitive_access_log_org_employee_created_idx")
  @@map("sensitive_access_log")
  @@schema("public")
}

// ── Etap 2: urlopy i nieobecności (ADR-0104) ────────────────────────────────────────────────────

enum LeaveType {
  VACATION
  ON_DEMAND
  OCCASIONAL
  CHILDCARE
  SICK
  UNPAID
  OTHER

  @@schema("public")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("public")
}

/// Roczne saldo urlopu wypoczynkowego pracownika (wymiar, urlop zaległy z poprzedniego roku i uwagi kadr).
model LeaveEntitlement {
  organizationId     String   @map("organization_id") @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  year               Int
  baseDays           Int?     @map("base_days")
  entitledDays       Int      @map("entitled_days")
  carriedOverDays    Int      @default(0) @map("carried_over_days")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid

  @@id([organizationId, employeeId, year])
  @@map("leave_entitlements")
  @@schema("public")
}

/// Wniosek albo wpis nieobecności. Dni pracy liczone przy złożeniu (wymiar pracy z Core i polskie święta).
/// Aktywne (oczekujące i zaakceptowane) nieobecności jednej osoby nie mogą się nakładać (EXCLUDE w migracji).
model LeaveRequest {
  id                   String      @id @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  employeeId           String      @map("employee_id") @db.Uuid
  type                 LeaveType
  startDate            DateTime    @map("start_date") @db.Date
  endDate              DateTime    @map("end_date") @db.Date
  workingDays          Int         @map("working_days")
  status               LeaveStatus
  note                 String?
  decisionNote         String?     @map("decision_note")
  requestedByAccountId String      @map("requested_by_account_id") @db.Uuid
  decidedByAccountId   String?     @map("decided_by_account_id") @db.Uuid
  decidedAt            DateTime?   @map("decided_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status, startDate])
  @@map("leave_requests")
  @@schema("public")
}
